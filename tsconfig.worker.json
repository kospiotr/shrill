{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    // Runtime types come from the generated worker-configuration.d.ts below,
    // which `npm run cf-typegen` regenerates from wrangler.jsonc.
    "types": ["vite/client"]
  },
  "include": ["server", "shared", "worker-configuration.d.ts"]
}
