/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shrill",
	"compatibility_date": "2025-04-10",
	"main": "server/index.ts",
	"assets": {
		// The Worker defers to this binding for every non-/api/ request, which is
		// what makes SPA deep links resolve: a configured Worker takes precedence
		// over `not_found_handling` on its own.
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "shrill-uploads"
		}
	],
	"observability": {
		"enabled": true
	}
}
