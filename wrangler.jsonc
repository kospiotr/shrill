/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shrill",
	"compatibility_date": "2025-04-10",
	"main": "server/index.ts",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Without this, Cloudflare resolves static assets BEFORE the Worker runs
		// at all (run_worker_first defaults to false) — so a path like
		// /api/harvest/<id>, which matches no literal file, would get the SPA's
		// not_found_handling fallback (index.html) instead of ever reaching our
		// fetch handler. Scoped to /api/* so static assets still skip the Worker
		// entirely, as Cloudflare recommends.
		"run_worker_first": ["/api/*"]
	},
	"r2_buckets": [
		{
			"binding": "GARDEN",
			"bucket_name": "shrill-uploads"
		}
	],
	"observability": {
		"enabled": true
	}
}
